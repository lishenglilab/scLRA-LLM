params {
  species = 'Human'
  tissue = 'Frontal cortex'
  study_description = 'Software demonstration: two artificial technical groups of selected cells from one public FCtx1_ONT specimen (GSE178175). Not a biological contrast.'
  llm_enabled = false
  threads = 4
  expect_cells = 60
  // Interactive HTML plots avoid headless-browser requirements in a quick demo.
  nanoplot_static = false
  min_cells = 10
  min_features = 200
  sample_stage_mapping = [['DemoA', 'TechnicalA'], ['DemoB', 'TechnicalB']]
  comparisons = [['TechnicalA', 'TechnicalB', 'TechnicalA_vs_TechnicalB']]
  dominant_n_cores = 2
  isoform_n_cores = 2
  integration_n_cores = 2
  // One public specimen split technically cannot support biological replicate modelling.
  isoform_switch_enabled = false
}
